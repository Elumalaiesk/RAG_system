# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Application ---
APP_NAME=Insurance RAG Service
# Optional. When set, every /api/v1 request must send an x-api-key header.
API_KEY=
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma
# Browser origins allowed to call the API, comma-separated. Only needed when the
# test console is NOT served from this app (served at / it is same-origin).
# "null" is the Origin a file:// page sends - it lets you open the HTML directly,
# but matches any local file, so drop it when you no longer need it.
# Never use "*" here. Replace with your real frontend origin for deployment.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,null

# --- Retrieval (runs locally, no cost, no network after first download) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COLLECTION_NAME=policies
# Measured in TOKENS, not characters (see CHUNK_UNIT).
# Must stay under the embedding model's input limit - 254 usable for MiniLM.
CHUNK_SIZE=220
CHUNK_OVERLAP=40
# tokens (recommended) | characters (older, can silently truncate)
CHUNK_UNIT=tokens
TOP_K=5
# Cosine-similarity floor for a chunk to be considered relevant.
# Tune with: python scripts/evaluate.py
MIN_SIMILARITY=0.10

# --- Generation (the only part that leaves your machine) ---
# Provider: gemini (Google, via its OpenAI-compatible endpoint) | anthropic
LLM_PROVIDER=gemini

# Must match the provider.
#   gemini    -> gemini-2.5-flash, gemini-flash-latest
#   anthropic -> claude-opus-5, claude-sonnet-5, claude-haiku-4-5
# Verified against Gemini's free tier: the Pro models return 429 (zero quota)
# and gemini-2.5-pro 404s as "no longer available to new users" while still
# appearing in the model list. Flash works without billing.
LLM_MODEL=gemini-2.5-flash

# OpenAI-compatible base URL. Ignored when LLM_PROVIDER=anthropic.
# Also works for a local runtime (Ollama, vLLM) if you point it there.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Only the key for the ACTIVE provider is needed. Never commit a real key.
# Gemini keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Anthropic-only dial: low | medium | high | xhigh | max. No effect on Gemini.
LLM_EFFORT=high
# A ceiling, not a target. Generous because on BOTH providers reasoning tokens
# come out of this same allowance - too small and you get an empty answer.
LLM_MAX_TOKENS=16000
# Anthropic-only: retry server-side on a fallback model if a request is refused.
LLM_REFUSAL_FALLBACK=true
